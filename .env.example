# Copie para .env.local e substitua pelos dados do app Web
# em Firebase Console > Configurações do projeto > Seus apps.
# Esses identificadores são públicos; nunca use credenciais de Admin SDK no frontend.
VITE_FIREBASE_API_KEY=COLE_AQUI
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef012345
